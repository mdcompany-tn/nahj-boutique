# Supabase project settings (Project Settings > API).
# Both values are public: they are embedded in the browser bundle.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: only needed to build a GitHub Pages project site locally.
# VITE_BASE_PATH=/nahj-boutique/

# Optional: Cloudflare Turnstile (anti-robot). Leave empty to disable the widget.
# Site key only — never put the secret key in the frontend.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
